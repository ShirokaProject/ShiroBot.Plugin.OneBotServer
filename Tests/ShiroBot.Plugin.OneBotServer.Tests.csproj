  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShiroBot.Plugin.OneBotServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ProtocolTests.cs" />
    <Compile Include="CqAndSegmentTests.cs" />
    <Compile Include="InfrastructureTests.cs" />
    <Compile Include="RegistryTests.cs" />
    <Compile Include="MediaCacheTests.cs" />
    <Compile Include="Actions/**/*.cs" />
    <Compile Include="Plugin/**/*.cs" />
    <Compile Include="OneBotTransportProtocolTests.cs" />
    <Compile Include="OneBotTransportIntegrationTests.cs" />
    <Compile Include="OneBotEventMapperTests.cs" />
  </ItemGroup>
</Project>
